# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=development
# Turnstile test keys published by Cloudflare: always pass. Do not use in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# At least 24 characters. Generate with: openssl rand -base64 32
SETUP_TOKEN=
# Optional in development (the development sign-in works without them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
