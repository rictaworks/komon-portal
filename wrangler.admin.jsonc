{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komon-portal-admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komon-portal",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
